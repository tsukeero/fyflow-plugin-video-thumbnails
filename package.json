{
  "name": "fyflow-plugin-video-thumbnail",
  "version": "0.1.1",
  "private": true,
  "description": "A fyflow-app Plugin: video thumbnails and contact sheets, made by a local thumbs-collage service",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "copy-service": "node scripts/copy-service.ts",
    "make-fixture": "node scripts/make-fixture.ts",
    "plugin-folder": "node scripts/plugin-folder.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "peerDependencies": {
    "fyflow-plugin-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fyflow-orchestration": "0.13.0",
    "fyflow-plugin-sdk": "0.6.0",
    "fyflow-scheduler": "0.6.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}

{
  "name": "fyflow-plugin-video-thumbnail",
  "version": "0.2.0",
  "private": true,
  "description": "A fyflow-app Plugin: video thumbnails and contact sheets, made by a local thumbs-collage service",
  "keywords": [
    "fyflow",
    "fyflow-plugin",
    "video",
    "thumbnails"
  ],
  "homepage": "https://github.com/tsukeero/fyflow-plugin-video-thumbnails#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukeero/fyflow-plugin-video-thumbnails.git"
  },
  "bugs": "https://github.com/tsukeero/fyflow-plugin-video-thumbnails/issues",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "fetch-service": "node scripts/fetch-service.ts",
    "make-fixture": "node scripts/make-fixture.ts",
    "plugin-folder": "node scripts/plugin-folder.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "peerDependencies": {
    "fyflow-plugin-sdk": "^0.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fyflow-orchestration": "0.14.0",
    "fyflow-plugin-sdk": "0.11.0",
    "fyflow-scheduler": "0.7.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "fyflow": {
    "name": "Video thumbnails",
    "icon": "image",
    "build": "pnpm plugin-folder",
    "pack": "dist/video-thumbnail"
  }
}
